node_modules/
out/
dist/

# Test output
test-results/
playwright-report/
.playwright/

# npm run eval:distill's report (regenerated every run; already covered by
# the unanchored `out/` rule above — listed explicitly so it stays ignored
# even if that rule is ever narrowed to the build output directory).
scripts/out/

# Rebuildable local index — must never become a second source of truth.
.nodebook/

# OS / editor noise
.DS_Store
*.log
.idea/
.vscode/

# TypeScript incremental build cache
*.tsbuildinfo

# Local Claude Code state (skills live in ~/.claude, not this repo)
.claude/

# Local-only files that must never ride along in a commit: the hats mirror
# (a copy of the CLAUDE.md stanza) and documents dropped in the root to test
# distill against.
AGENTS.md
/*.pdf
/*.epub
/*.docx
