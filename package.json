{
  "name": "nodebook",
  "version": "0.1.1",
  "description": "A source-mode markdown notebook with a knowledge index.",
  "main": "./out/main/index.js",
  "author": "Vlad Lysyy <lysyy@me.com>",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "gen:icon": "node scripts/gen-icon.mjs",
    "pack": "electron-vite build && electron-builder --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:live": "npm run build && playwright test --config playwright.live.config.ts",
    "eval:distill": "vitest run --config vitest.eval.config.ts",
    "postinstall": "electron-builder install-app-deps"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "adm-zip": "^0.6.1",
    "sharp": "^0.35.5",
    "app-builder-lib": {
      "minimatch@>=7 <11.0.1": "11.0.9"
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "^3.1.3",
    "@huggingface/transformers": "^4.3.2",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@napi-rs/canvas": "^1.0.1",
    "better-sqlite3": "^13.2.0",
    "chokidar": "^5.0.0",
    "elkjs": "^0.12.1",
    "fflate": "^0.8.3",
    "jschardet": "^4.1.0",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smol-toml": "^1.9.1",
    "sqlite-vec": "^0.1.9",
    "turndown": "^7.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
